  "mainPath": ["task_criteria", "frozen_baseline", "failure_diagnosis", "bounded_revision", "paired_evaluation", "gated_canary"],
  "nodes": [
    {"id": "task_criteria", "lane": "iteration", "col": 0, "type": "frontend", "label": "任务验收", "sublabel": "目标·约束·验收", "width": 92},
    {"id": "frozen_baseline", "lane": "iteration", "col": 1, "type": "database", "label": "固定基线", "sublabel": "版本·样例·指标", "width": 92},
    {"id": "failure_diagnosis", "lane": "diagnosis", "col": 2, "type": "backend", "label": "失败归因", "sublabel": "定位可修的指令问题", "width": 92},
